{
  "preprocess": {
    "input": "mnist_opendataset",
    "timesteps": 4,
    "step_generation": "direct"
  },

  "train": {
    "epoch": 10,
    "kfold": 5,
    "repeat": 1
  },

  "global": {
    "input_size": [28, 28],
    "input_channels": 1,
    "output_classes": 10,
    "neuron_type": "ws8"
  },

  "nodes": [
    // 28x28x1 -> 24x24x12
    {
      "name": "conv2d_1",
      "type": "Conv2d",
      "in_channels": 1,
      "out_channels": 12,
      "kernel_size": 5,
      "stride": 1,
      "padding": 0
      // "bias": false
    },

    // 24x24x12 -> 12x12x12
    {
      "name": "maxpool2d_1",
      "type": "MaxPool2d",
      "kernel_size": 2,
      "padding": 0
    },
    {
      "name": "leaky_1",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // 12x12x12 -> 8x8x64
    {
      "name": "conv2d_2",
      "type": "Conv2d",
      "in_channels": 12,
      "out_channels": 64,
      "kernel_size": 5,
      "stride": 1,
      "padding": 0
      // "bias": false
    },

    // 8x8x64 -> 4x4x64
    {
      "name": "avgpool2d_1",
      "type": "AvgPool2d",
      "kernel_size": 2,
      "padding": 0
    },
    {
      "name": "leaky_2",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "zero",
      "learn_threshold": false
    },

    // 4x4x64 -> 1024
    {"name": "flatten_1", "type": "Flatten"},
    {
      "name": "linear_1",
      "type": "Linear",
      "in_features": 1024,
      "out_features": 10
    },
    {
      "name": "leaky_3",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    }
  ]
}
